# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
DJANGO_SETTINGS_MODULE=fitna_backend.settings.production

# Allowed Hosts (comma-separated, no spaces)
ALLOWED_HOSTS=fitna-backend.onrender.com

# CORS (comma-separated, full URL with protocol)
CORS_ALLOWED_ORIGINS=https://fitna-frontend.vercel.app

# Database (PostgreSQL URL from Render)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Cloudinary (required in production)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
